{
  "name": "aging-test-root",
  "version": "2.0.0",
  "private": true,
  "description": "Aging-Test monorepo: React frontend + Firebase Cloud Functions backend",
  "scripts": {
    "install:all":    "npm install --prefix frontend",
    "build":          "npm run build --prefix frontend",
    "dev":            "npm run dev --prefix frontend",
    "test":           "npm run test --prefix frontend",
    "test:backend":   "python -m pytest tests/firebase/ -v",
    "typecheck":      "npm run typecheck --prefix frontend",
    "lint":           "npm run lint --prefix frontend",
    "emulate":        "firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "emulate:clean":  "firebase emulators:start",
    "deploy":         "npm run build && firebase deploy",
    "deploy:hosting":   "npm run build && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules":     "firebase deploy --only firestore",
    "backup:supabase":  "node scripts/backup_supabase.mjs",
    "import:supabase":  "node scripts/import_from_supabase.mjs",
    "import:excel":     "node scripts/import_from_excel.mjs",
    "verify:migration": "node scripts/verify_migration.mjs",
    "operator:add":     "node scripts/add_operator.mjs"
  },
  "devDependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-tools": "^13.31.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
